{
    "name": "@bookchaowalit/solo-empire-mcp",
    "version": "1.0.0",
    "description": "MCP server for Solo Empire knowledge base and progress tracking",
    "type": "module",
    "main": "dist/index.js",
    "files": [
        "dist/",
        "README.md"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/bookchaowalit/platform-mcp-aggregator.git"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test tests/*.test.ts",
        "check": "npm run typecheck && npm test"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0",
        "zod": "^4.6.5"
    },
    "overrides": {
        "hono": "4.13.5"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.1",
        "better-sqlite3": "^13.0.3",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    }
}
